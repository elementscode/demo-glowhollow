import "./style.css";
import { LiveView } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { SidebarProvider, SidebarInset } from "@elements/ui/sidebar";
import { Alert } from "@elements/ui/alert";
import { AlertDialog, AlertDialogFooter, AlertDialogCancel, AlertDialogAction } from "@elements/ui/alert-dialog";
import { Avatar } from "@elements/ui/avatar";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Input } from "@elements/ui/input";
import { ItemGroup, Item, ItemMedia, ItemContent, ItemTitle, ItemDescription, ItemActions } from "@elements/ui/item";
import { AppSidebar, Me } from "#app/shared/templates/sidebar";
import { avatarColor, initial } from "#app/shared/services/avatar";
import { ChannelMember, ChatChannel } from "#app/shared/services/chat";
import { MemberRow, removeMember } from "#app/shared/services/members";

interface NewChannel {
  name: string;
  topic: string;
}

interface Editing {
  id: string;
  name: string;
  topic: string;
}

interface Admin {
  members: MemberRow[];
  confirmRemove: string;
  confirming: boolean;
  error: string;
}

function sorted(channels: LiveView<ChatChannel>): ChatChannel[] {
  return channels.sort((a, b) => Number(a.archived) - Number(b.archived) || +a.createdAt - +b.createdAt);
}

function slug(value: string): string {
  return value.trim().toLowerCase().replace(/^#/, "").replace(/[^a-z0-9-]+/g, "-").replace(/^-+|-+$/g, "");
}

function onCreate(channels: LiveView<ChatChannel>, draft: NewChannel, state: Admin) {
  state.error = "";

  try {
    channels.insert(
      { name: slug(draft.name), topic: draft.topic.trim(), archived: false, createdAt: new Date() },
      () => {
        draft.name = "";
        draft.topic = "";
      },
    );
  } catch (err: any) {
    state.error = err.message;
  }
}

function onEdit(editing: Editing, c: ChatChannel) {
  editing.id = c.id;
  editing.name = c.name;
  editing.topic = c.topic;
}

function onSaveEdit(channels: LiveView<ChatChannel>, editing: Editing, c: ChatChannel, state: Admin) {
  state.error = "";

  try {
    channels.update({ ...c, name: slug(editing.name), topic: editing.topic.trim() }, () => editing.id = "");
  } catch (err: any) {
    state.error = err.message;
  }
}

function onSetArchived(channels: LiveView<ChatChannel>, c: ChatChannel, archived: boolean, state: Admin) {
  state.error = "";

  try {
    channels.update({ ...c, archived });
  } catch (err: any) {
    state.error = err.message;
  }
}

function onAskRemove(state: Admin, member: MemberRow) {
  state.confirmRemove = member.id;
  state.confirming = true;
}

function confirmTarget(state: Admin): MemberRow | undefined {
  return state.members.find((m) => m.id === state.confirmRemove);
}

function onRemove(state: Admin) {
  let member = confirmTarget(state);
  state.error = "";

  if (!member) {
    return;
  }

  try {
    state.members = removeMember(member.id);
    state.confirmRemove = "";
  } catch (err: any) {
    state.error = err.message;
  }
}

function joined(d: Date): string {
  return new Date(d).toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" });
}

<html lang="en" class="page-admin" (
  me: Me,
  channels: LiveView<ChatChannel>,
  memberships: LiveView<ChannelMember>,
  members: MemberRow[],
  private draft: NewChannel = { name: "", topic: "" },
  private editing: Editing = { id: "", name: "", topic: "" },
  private state: Admin = { members, confirmRemove: "", confirming: false, error: "" },
)>
  <head>
    <title>Admin · Glowhollow</title>
    <meta name="description" content="Manage Glowhollow channels and members.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <SidebarProvider class="admin" shortcut="" cookie="">
      <AppSidebar {channels} {memberships} currentId="" {me} />

      <SidebarInset class="admin-main">
        <header class="admin-head">
          <h1>Admin</h1>
          <Badge variant="accent">@{me.displayName}</Badge>
          <Button href="/" variant="ghost" size="sm" class="admin-back">Back to chat</Button>
        </header>

        <div class="admin-content stack is-lg">
          <Alert e:if={state.error} variant="danger" description={state.error} />

          <Card title="Channels" level={2} description="New channels include every member. Archived channels stay readable but no one can post.">
            <CardContent class="stack">
              <form class="new-channel" onsubmit={() => onCreate(channels, draft, state)}>
                <Input value={draft.name} placeholder="channel-name" required attrs={{ "aria-label": "New channel name", maxlength: 40 }} />
                <Input value={draft.topic} placeholder="Topic (optional)" attrs={{ "aria-label": "New channel topic", maxlength: 120 }} />
                <Button type="submit" variant="primary">Create channel</Button>
              </form>

              <ItemGroup label="Channels" class="admin-list">
                <Item e:for={c of sorted(channels)} size="sm" class={["admin-row", c.archived && "is-muted"].filter(Boolean).join(" ")}>
                  <form e:if={editing.id === c.id} class="rename-form" onsubmit={() => onSaveEdit(channels, editing, c, state)}>
                    <Input value={editing.name} size="sm" required attrs={{ "aria-label": "Channel name", maxlength: 40, autofocus: true }} />
                    <Input value={editing.topic} size="sm" placeholder="Topic" attrs={{ "aria-label": "Channel topic", maxlength: 120 }} />
                    <Button type="submit" variant="primary" size="sm">Save</Button>
                    <Button variant="ghost" size="sm" onclick={() => editing.id = ""}>Cancel</Button>
                  </form>

                  <ItemContent e:if={editing.id !== c.id}>
                    <ItemTitle>
                      <a e:if={!c.archived} href={`/c/${c.id}`}>#{c.name}</a>
                      <span e:else>#{c.name}</span>
                      <Badge e:if={c.archived} variant="warning">archived</Badge>
                    </ItemTitle>
                    <ItemDescription>{c.topic || "No topic"}</ItemDescription>
                  </ItemContent>

                  <ItemActions e:if={editing.id !== c.id}>
                    <Button size="sm" onclick={() => onEdit(editing, c)}>Rename</Button>
                    <Button e:if={!c.archived} size="sm" onclick={() => onSetArchived(channels, c, true, state)}>Archive</Button>
                    <Button e:else size="sm" onclick={() => onSetArchived(channels, c, false, state)}>Restore</Button>
                  </ItemActions>
                </Item>
              </ItemGroup>
            </CardContent>
          </Card>

          <Card title="Members" level={2} description="Removing someone signs them out everywhere and blocks them from signing back in. Their past messages stay.">
            <CardContent>
              <ItemGroup label="Members" class="admin-list">
                <Item e:for={m of state.members} size="sm" class={m.removed ? "admin-row is-muted" : "admin-row"}>
                  <ItemMedia variant="avatar">
                    <Avatar fallback={initial(m.displayName)} class="member-avatar" attrs={{ style: avatarColor(m.displayName) }} />
                  </ItemMedia>

                  <ItemContent>
                    <ItemTitle>
                      @{m.displayName}
                      <Badge e:if={m.role === "admin"} variant="accent">admin</Badge>
                      <Badge e:if={m.removed} variant="danger">removed</Badge>
                    </ItemTitle>
                    <ItemDescription>{m.email} · joined {joined(m.createdAt)} · {m.messageCount} {m.messageCount === 1 ? "message" : "messages"}</ItemDescription>
                  </ItemContent>

                  <ItemActions e:if={!m.removed && m.role !== "admin"}>
                    <Button size="sm" onclick={() => onAskRemove(state, m)}>Remove</Button>
                  </ItemActions>
                </Item>
              </ItemGroup>
            </CardContent>
          </Card>
        </div>

        <AlertDialog open={state.confirming}
                     title={`Remove @${confirmTarget(state)?.displayName ?? ""}?`}
                     description="This signs them out everywhere and blocks them from signing back in. Their past messages stay.">
          <AlertDialogFooter>
            <AlertDialogCancel>Cancel</AlertDialogCancel>
            <AlertDialogAction variant="danger" onclick={() => onRemove(state)}>Remove @{confirmTarget(state)?.displayName}</AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialog>
      </SidebarInset>
    </SidebarProvider>
  </body>
</html>
