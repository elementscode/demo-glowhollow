import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Logo } from "#app/shared/templates/logo";
import { signin } from "#app/shared/services/auth";
import { avatarColor, initial } from "#app/shared/services/avatar";
import { Alert } from "@elements/ui/alert";
import { Avatar } from "@elements/ui/avatar";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { ItemGroup, Item, ItemMedia, ItemContent, ItemTitle, ItemDescription } from "@elements/ui/item";

interface SigninForm {
  email: string;
  password: string;
  error: string;
}

interface DemoLogin {
  id: string;
  name: string;
  email: string;
  role: string;
}

export const DEMO_PASSWORD = "glowhollow123";

export const DEMO_LOGINS: DemoLogin[] = [
  { id: "maya", name: "maya", email: "maya@glowhollow.test", role: "admin" },
  { id: "jonas", name: "jonas", email: "jonas@glowhollow.test", role: "member" },
  { id: "priya", name: "priya", email: "priya@glowhollow.test", role: "member" },
  { id: "theo", name: "theo", email: "theo@glowhollow.test", role: "member" },
];

function onSubmit(form: SigninForm) {
  try {
    signin(form.email, form.password);
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
  }
}

function onPickDemo(form: SigninForm, login: DemoLogin) {
  form.email = login.email;
  form.password = DEMO_PASSWORD;
  form.error = "";
}

<html lang="en" class="page-signin" (
  showDemoLogins: boolean,
  private form: SigninForm = { email: "", password: "", error: "" },
)>
  <head>
    <title>Sign in · Glowhollow</title>
    <meta name="description" content="Sign in to Glowhollow, a private chat for our community.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <main class="auth">
      <div class="auth-column stack is-lg">
        <div class="stack is-sm">
          <div class="row auth-brand"><Logo size="lg" /></div>
          <p class="auth-lede">A private chat for our small corner of the internet.</p>
        </div>

        <Card>
          <CardContent>
            <form class="stack" onsubmit={() => onSubmit(form)}>
              <h1>Sign in</h1>

              <Alert e:if={form.error} variant="danger" description={form.error} />

              <Field label="Email" required>
                <Input type="email"
                       name="email"
                       value={form.email}
                       placeholder="you@example.com"
                       attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
              </Field>

              <Field label="Password" required>
                <Input type="password"
                       name="password"
                       value={form.password}
                       attrs={{ autocomplete: "current-password" }} />
              </Field>

              <Button type="submit" variant="primary" block>Sign in</Button>
            </form>
          </CardContent>
        </Card>

        <p class="auth-switch">New here? <a href="/signup">Create an account</a></p>

        <Card e:if={showDemoLogins} title="Seeded logins" level={2}>
          <CardContent class="stack is-sm">
            <p class="demo-password">Click one to fill the form. Every seeded account uses the password <code>{DEMO_PASSWORD}</code>.</p>

            <ItemGroup label="Seeded logins">
              <Item e:for={login of DEMO_LOGINS} size="sm" onclick={() => onPickDemo(form, login)}>
                <ItemMedia variant="avatar">
                  <Avatar fallback={initial(login.name)} class="member-avatar" attrs={{ style: avatarColor(login.name) }} />
                </ItemMedia>

                <ItemContent>
                  <ItemTitle>
                    @{login.name}
                    <Badge variant={login.role === "admin" ? "accent" : "secondary"}>{login.role}</Badge>
                  </ItemTitle>
                  <ItemDescription>{login.email}</ItemDescription>
                </ItemContent>
              </Item>
            </ItemGroup>
          </CardContent>
        </Card>
      </div>
    </main>
  </body>
</html>
