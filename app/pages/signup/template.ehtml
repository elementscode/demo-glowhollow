import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Logo } from "#app/shared/templates/logo";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

interface SignupPageForm {
  email: string;
  password: string;
  displayName: string;
  error: string;
}

function onSubmit(form: SignupPageForm) {
  try {
    signup({ email: form.email, password: form.password, displayName: form.displayName });
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
  }
}

<html lang="en" class="page-signup" (
  private form: SignupPageForm = { email: "", password: "", displayName: "", error: "" },
)>
  <head>
    <title>Create an account · Glowhollow</title>
    <meta name="description" content="Join Glowhollow with an email and password.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <main class="auth">
      <div class="auth-column stack is-lg">
        <div class="stack is-sm">
          <div class="row auth-brand"><Logo size="lg" /></div>
          <p class="auth-lede">Pull up a chair. All you need is an email and a password.</p>
        </div>

        <Card>
          <CardContent>
            <form class="stack" onsubmit={() => onSubmit(form)}>
              <h1>Create an account</h1>

              <Alert e:if={form.error} variant="danger" description={form.error} />

              <Field label="Display name" description="What people type to @mention you. Letters, numbers, dots, dashes, underscores." required>
                <Input name="displayName"
                       value={form.displayName}
                       placeholder="ada"
                       attrs={{ autocomplete: "username", autocapitalize: "none", spellcheck: "false", pattern: "[A-Za-z0-9_.\\-]{2,24}", maxlength: 24 }} />
              </Field>

              <Field label="Email" required>
                <Input type="email"
                       name="email"
                       value={form.email}
                       placeholder="you@example.com"
                       attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
              </Field>

              <Field label="Password" description={`At least ${MIN_PASSWORD} characters.`} required>
                <Input type="password"
                       name="password"
                       value={form.password}
                       attrs={{ autocomplete: "new-password", minlength: MIN_PASSWORD }} />
              </Field>

              <Button type="submit" variant="primary" block>Create account</Button>
            </form>
          </CardContent>
        </Card>

        <p class="auth-switch">Already a member? <a href="/signin">Sign in</a></p>
      </div>
    </main>
  </body>
</html>
