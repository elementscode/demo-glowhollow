import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Logo } from "#app/shared/templates/logo";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";

interface SignupPageForm {
  email: string;
  password: string;
  displayName: string;
  error: string;
}

function onSubmit(form: SignupPageForm) {
  try {
    signup({ email: form.email, password: form.password, displayName: form.displayName });
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
  }
}

<html lang="en" class="page-signup" (
  private form: SignupPageForm = { email: "", password: "", displayName: "", error: "" },
)>
  <head>
    <title>Create an account · Campfire</title>
    <meta name="description" content="Join Campfire with an email and password.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <main class="auth">
      <div class="auth-column stack is-lg">
        <div class="stack is-sm">
          <div class="row auth-brand"><Logo size="lg" /></div>
          <p class="auth-lede">Pull up a log. All you need is an email and a password.</p>
        </div>

        <div class="card">
          <div class="card-body">
            <form class="stack" onsubmit={() => onSubmit(form)}>
              <h1>Create an account</h1>

              <p e:if={form.error} class="callout is-danger" role="alert">{form.error}</p>

              <div class="field">
                <label for="displayName">Display name</label>
                <input id="displayName"
                       name="displayName"
                       type="text"
                       value={form.displayName}
                       autocomplete="username"
                       autocapitalize="none"
                       spellcheck={false}
                       placeholder="ada"
                       pattern="[A-Za-z0-9_.\-]{2,24}"
                       maxlength={24}
                       required>
                <p class="hint">What people type to @mention you. Letters, numbers, dots, dashes, underscores.</p>
              </div>

              <div class="field">
                <label for="email">Email</label>
                <input id="email"
                       name="email"
                       type="email"
                       value={form.email}
                       autocomplete="email"
                       autocapitalize="none"
                       spellcheck={false}
                       placeholder="you@example.com"
                       required>
              </div>

              <div class="field">
                <label for="password">Password</label>
                <input id="password"
                       name="password"
                       type="password"
                       value={form.password}
                       autocomplete="new-password"
                       minlength={MIN_PASSWORD}
                       required>
                <p class="hint">At least {MIN_PASSWORD} characters.</p>
              </div>

              <button type="submit" class="is-primary is-block">Create account</button>
            </form>
          </div>
        </div>

        <p class="auth-switch">Already a member? <a href="/signin">Sign in</a></p>
      </div>
    </main>
  </body>
</html>
