import "./style.css";
import { LiveView, redirect } from "@elements/app";
import {
  Sidebar, SidebarHeader, SidebarContent, SidebarFooter, SidebarGroup, SidebarGroupLabel,
  SidebarGroupContent, SidebarMenu, SidebarMenuItem, SidebarMenuButton, SidebarMenuBadge,
} from "@elements/ui/sidebar";
import { Avatar } from "@elements/ui/avatar";
import { Button } from "@elements/ui/button";
import { Logo } from "#app/shared/templates/logo";
import { signout } from "#app/shared/services/auth";
import { avatarColor, initial } from "#app/shared/services/avatar";
import { ChannelMember, ChatChannel } from "#app/shared/services/chat";

export interface Me {
  id: string;
  displayName: string;
  isAdmin: boolean;
}

interface SidebarRow {
  id: string;
  name: string;
  unread: number;
}

/** Open channels in creation order, each with this member's unread count. */
function sidebarRows(channels: LiveView<ChatChannel>, memberships: LiveView<ChannelMember>): SidebarRow[] {
  let unread = new Map<string, number>();

  for (let m of memberships) {
    unread.set(m.channelId, m.unread);
  }

  return channels
    .filter((c) => !c.archived)
    .sort((a, b) => +a.createdAt - +b.createdAt)
    .map((c) => ({ id: c.id, name: c.name, unread: unread.get(c.id) ?? 0 }));
}

function onSignout() {
  signout();
  redirect("/signin");
}

<AppSidebar (
  channels: LiveView<ChatChannel>,
  memberships: LiveView<ChannelMember>,
  currentId: string,
  me: Me,
)>
  <Sidebar label="Channels">
    <SidebarHeader>
      <a href="/" class="logo-link"><Logo /></a>
    </SidebarHeader>

    <SidebarContent>
      <SidebarGroup>
        <SidebarGroupLabel>
          <span>Channels</span>
          <a e:if={me.isAdmin} href="/admin" class="sidebar-manage">Manage</a>
        </SidebarGroupLabel>

        <SidebarGroupContent>
          <SidebarMenu>
            <SidebarMenuItem e:for={row of sidebarRows(channels, memberships)} e:key={(row: SidebarRow) => row.id}>
              <SidebarMenuButton href={`/c/${row.id}`}
                                 isActive={row.id === currentId}
                                 class={row.unread > 0 && row.id !== currentId ? "is-unread" : ""}>
                <span class="channel-hash" aria-hidden="true">#</span>
                <span>{row.name}</span>
              </SidebarMenuButton>
              <SidebarMenuBadge e:if={row.unread > 0 && row.id !== currentId}
                                class="unread-count"
                                attrs={{ "aria-label": `${row.unread} unread` }}>{row.unread > 99 ? "99+" : row.unread}</SidebarMenuBadge>
            </SidebarMenuItem>
          </SidebarMenu>
        </SidebarGroupContent>
      </SidebarGroup>
    </SidebarContent>

    <SidebarFooter>
      <div class="sidebar-me-row">
        <Avatar fallback={initial(me.displayName)} class="member-avatar" attrs={{ style: avatarColor(me.displayName) }} />
        <span class="sidebar-me">
          <strong>@{me.displayName}</strong>
          <span>{me.isAdmin ? "Admin" : "Member"}</span>
        </span>
        <Button variant="ghost" size="sm" onclick={() => onSignout()}>Sign out</Button>
      </div>
    </SidebarFooter>
  </Sidebar>
</AppSidebar>
